# Copy to .env (copy .env.example .env) - .env is git-ignored. Never commit real credentials.
BASE_URL=https://sivika.onrender.com
BROWSER=chrome
HEADLESS=false
DEFAULT_TIMEOUT=20
PAGE_LOAD_TIMEOUT=90

# Only needed for tests marked "auth". Use a dedicated test account, never a personal one.
# Leave blank and the auth tests are skipped.
SIVIKA_TEST_USERNAME=
SIVIKA_TEST_PASSWORD=
